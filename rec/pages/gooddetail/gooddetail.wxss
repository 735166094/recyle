/* pages/gooddetail/gooddetail.wxss */
page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.detail-scroll {
  height: 100%;
  padding-bottom: 120rpx;
}

/* 商品图片 */
.goods-img-container {
  background-color: white;
  padding: 20rpx;
}

.goods-img {
  width: 100%;
  border-radius: 16rpx;
}

/* 商品信息 */
.goods-info {
  background-color: white;
  margin-top: 20rpx;
  padding: 25rpx 20rpx;
}

.goods-title {
  font-size: 34rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.goods-price {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  padding-bottom: 25rpx;
  border-bottom: 1px solid #F5F5F5;
}

.currency {
  font-size: 28rpx;
  color: #FF6B35;
  margin-right: 5rpx;
}

.price {
  font-size: 38rpx;
  color: #FF6B35;
  font-weight: bold;
}

.sales-volume {
  font-size: 26rpx;
  color: #999;
  margin-left: auto;
}

.goods-desc, .goods-spec {
  margin-bottom: 30rpx;
}

.desc-title, .spec-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
  display: block;
}

.desc-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.spec-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.spec-item {
  font-size: 26rpx;
  color: #666;
  background-color: #F5F5F5;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: white;
  border-top: 1px solid #F1F1F1;
  z-index: 999;
}

.bottom-btn {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
}

.favorite-btn {
  flex-direction: column;
  color: #666;
  padding-top: 10rpx;
}

.favorite-btn .active {
  color: #FF6B35;
}

.cart-btn {
  flex-direction: column;
  color: #666;
  padding-top: 10rpx;
  position: relative;
}

.cart-badge {
  position: absolute;
  top: 5rpx;
  right: 60rpx;
  background-color: #FF6B35;
  color: white;
  font-size: 20rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.add-cart-btn {
  background-color: #FF8A5C;
  color: white;
}

.buy-btn {
  background-color: #FF6B35;
  color: white;
}
