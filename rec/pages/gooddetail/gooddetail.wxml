<!-- 商品详情页面 -->
<scroll-view scroll-y="true" class="detail-scroll">
  <!-- 商品图片 -->
  <view class="goods-img-container">
    <image class="goods-img" src="{{goods.imgUrl}}" mode="widthFix" />
  </view>

  <!-- 商品信息 -->
  <view class="goods-info">
    <view class="goods-title">{{goods.title}}</view>
    
    <view class="goods-price">
      <text class="currency">{{goods.currency}}</text>
      <text class="price">{{goods.price}}</text>
      <view class="sales-volume">销量: {{goods.sales}}件</view>
    </view>
    
    <view class="goods-desc">
      <text class="desc-title">商品描述:</text>
      <text class="desc-content">{{goods.description}}</text>
    </view>
    
    <view class="goods-spec">
      <text class="spec-title">规格参数:</text>
      <view class="spec-list">
        <view class="spec-item" wx:for="{{goods.specifications}}" wx:key="index">{{item}}</view>
      </view>
    </view>
  </view>
</scroll-view>

<!-- 底部操作栏 -->
<view class="bottom-bar">
  <view class="bottom-btn favorite-btn" bindtap="toggleFavorite">
    <icon type="{{isFavorite ? 'star' : 'star-o'}}" size="30" color="{{isFavorite ? '#FF6B35' : '#666'}}" />
    <text class="{{isFavorite ? 'active' : ''}}">{{isFavorite ? '已收藏' : '收藏'}}</text>
  </view>
  
  <view class="bottom-btn cart-btn" bindtap="goToCart">
    <icon type="cart" size="30" color="#fff" />
    <text>购物车</text>
    <view wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</view>
  </view>
  
  <view class="bottom-btn add-cart-btn" bindtap="addToCart">加入购物车</view>
  
  <view class="bottom-btn buy-btn" bindtap="buyNow">立即购买</view>
</view>
