.spacecontainer {
  min-height: 100vh;
}

.top-nav {
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  position: relative;
  z-index: 10;
}

.nav-scroll {
  width: 100%;
  white-space: nowrap;
}

.nav-items {
  display: inline-flex;
  padding: 0 10rpx;
}

.nav-item {
  padding: 26rpx 30rpx;
  font-size: 30rpx;
  position: relative;
  cursor: pointer;
}

.nav-item.active {
  /* color: #1677ff; */
  background: linear-gradient(to bottom, #415a77, #778da9);
  font-weight: 500;
}

.nav-indicator {
  height: 6rpx;
  background: linear-gradient(to bottom, #415a77, #778da9);
  position: absolute;
  bottom: 0;
  transition: all 0.3s ease;
  border-radius: 3rpx;
}

.content-scroll {
  width: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.tab-content {
  width: 100%;
}

.hero-section {
  padding: 40rpx 30rpx;
}

.hero-image {
  width: 100%;
  border-radius: 25rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 30rpx;
}

.hero-content {
  text-align: center;
  padding: 20rpx 0;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  display: block;
  background: linear-gradient(90deg, #4facfe, #00f2fe);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #a0a0a0;
  margin-bottom: 40rpx;
  display: block;
}

.hero-actions {
  display: flex;
  justify-content: center;
  gap: 30rpx;
}

.quick-link text {
  font-size: 26rpx;
  color: #e0e1dd;
}

.primary-btn {
  background: linear-gradient(90deg, #1677ff, #0052d9);
  color: white;
  padding: 22rpx 60rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  border: none;
  box-shadow: 0 5rpx 15rpx rgba(22, 119, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.secondary-btn {
  background-color: rgba(255, 255, 255, 0.08);
  color: #e0e1dd;
  padding: 22rpx 60rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.section {
  padding: 60rpx 30rpx;
  position: relative;
}

.section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 85%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 50rpx;
  display: block;
  text-align: center;
  position: relative;
}

.section-title::after {
  content: '';
  display: block;
  width: 80rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #4facfe, #00f2fe);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 50rpx;
  border-radius: 3rpx;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30rpx;
}

.service-card {
  width: 80%;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 35rpx 25rpx;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: all 0.3s ease;
}

.service-card:hover {
  transform: translateY(-10rpx);
  box-shadow: 0 15rpx 30rpx rgba(0, 0, 0, 0.2);
  border-color: rgba(22, 119, 255, 0.3);
}

.service-name {
  font-size: 35rpx;
  font-weight: 600;
  margin-bottom: 15rpx;
  display: block;
}

.service-desc {
  font-size: 28rpx;
  color: #a0a0a0;
  line-height: 1.5;
}

/* 流程说明 */
.process-container {
  display: flex;
  overflow-x: auto;
  padding: 20rpx 0 40rpx;
  gap: 10rpx;
  scrollbar-width: none;
}

.process-container::-webkit-scrollbar {
  display: none;
}

.process-step {
  min-width: 160rpx;
  text-align: center;
  padding: 0 10rpx;
  flex-shrink: 0;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #1677ff, #0052d9);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin: 0 auto 20rpx;
  box-shadow: 0 5rpx 15rpx rgba(22, 119, 255, 0.3);
}

.step-name {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #a0a0a0;
  line-height: 1.4;
}

.process-line {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, #1677ff, rgba(22, 119, 255, 0.2));
  align-self: center;
  flex-shrink: 0;
}

/* 服务优势 */
.advantages-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 25rpx;
}

.advantage-item {
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.05);
  padding: 25rpx;
  border-radius: 15rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.advantage-text {
  font-size: 28rpx;
  line-height: 1.4;
}

/* 价格查询卡片 */
.price-section {
  padding-bottom: 40rpx;
}

.price-card {
  background: linear-gradient(135deg, rgba(22, 119, 255, 0.15), rgba(0, 82, 217, 0.1));
  border: 1px solid rgba(22, 119, 255, 0.2);
  border-radius: 20rpx;
  padding: 45rpx 30rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 40rpx;
}

.price-title {
  font-size: 34rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.price-subtitle {
  font-size: 26rpx;
  color: #a0a0a0;
  display: block;
  margin-bottom: 35rpx;
}

.price-btn {
  background: linear-gradient(90deg, #1677ff, #0052d9);
  color: white;
  padding: 12rpx 0;
  border-radius: 50rpx;
  font-size:28rpx;
  border: none;
  width: 60%;
  box-shadow: 0 5rpx 15rpx rgba(22, 119, 255, 0.3);
}

.price-tips {
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
  color: #1677ff;
}

.tips-list {
  gap: 15rpx;
  display: flex;
  flex-direction: column;
}

.tips-item {
  font-size: 26rpx;
  color: #a0a0a0;
  line-height: 1.5;
}

/* 联系我们 */
.contact-info {
  /* margin-bottom: 40rpx; */
  margin: 40rpx  20rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.contact-item icon {
  color: #1677ff;
  margin-right: 25rpx;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.contact-text {
  margin-left: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.contact-btn {
  background: linear-gradient(90deg, #1677ff, #0052d9);
  color: white;
  padding: 22rpx 0;
  border-radius: 50rpx;
  font-size: 26rpx;
  border: none;
  width: 90%;
  height: auto;
  box-shadow: 0 5rpx 15rpx rgba(22, 119, 255, 0.3);
  margin-bottom: 40rpx;
}

.map-image {
  width: 100%;
  display: block;
}









/* 底部 */
.footer {
  padding: 40rpx 30rpx;
  text-align: center;
  margin-top: 20rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.footer-text {
  font-size: 24rpx;
  color: #a0a0a0;
  display: block;
  margin-bottom: 10rpx;
}