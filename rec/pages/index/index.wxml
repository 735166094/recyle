<!-- 搜索框 -->
<view class="search-wrap">
  <view class="search-bar">
    <icon type="search" size="20" color="#B0B6BE" class="search-icon" />
    <input class="search-input" type="text" placeholder="搜索车辆品牌或商城商品" placeholder-style="color:#B0B6BE;" bindinput="onInput" bindconfirm="onSearch" value="{{inputValue}}" />
    <icon wx:if="{{inputValue}}" type="clear" size="20" color="#B0B6BE" class="clear-icon" bindtap="clearInput" />
  </view>
</view>

<!-- 轮播图 -->
<view class="banner-wrapper">
  <swiper autoplay interval="3500" circular indicator-active-color="#FFFFFF" indicator-color="rgba(255,255,255,0.3)" class="banner-swiper">
    <block wx:for="{{bannerList}}" wx:key="id">
      <swiper-item class="swiper-item">
        <image src="{{item.image}}" mode="aspectFill" class="banner-img" />
        <view class="banner-text">
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-desc">{{item.desc}}</text>
        </view>
      </swiper-item>
    </block>
  </swiper>
</view>

<!-- 快捷入口 -->
<view class="menu">
  <view class="menu-item" bind:tap="goToRecyleCarPage">
    <view class="menu-backc">
      <image class="menu-icon" src="/static/icon/recyle.png" mode="widthFix" />
    </view>
    <text class="menu-text">报废车回收</text>
  </view>
  <view class="menu-item" bind:tap="goToShopPage" data-path="/pages/mall/mall">
    <view class="menu-backc">
      <image class="menu-icon" src="/static/icon/shop.png" mode="widthFix" />
    </view>
    <text class="menu-text">积分商城</text>
  </view>
  <view class="menu-item" bind:tap="goToPolicyPage">
    <view class="menu-backc">
      <image class="menu-icon" src="/static/icon/policy.png" mode="widthFix" />
    </view>
    <text class="menu-text">政策资讯</text>
  </view>
  <view class="menu-item" bind:tap="goToPointPage">
    <view class="menu-backc">
      <image class="menu-icon" src="/static/icon/points.png" mode="widthFix" />
    </view>
    <text class="menu-text">我的积分</text>
  </view>
</view>

<!-- 车辆快速评估 -->
<view>
  <view class="news-title">
    <view class="news-titlespace"></view>
    <text class="news-titlename">车辆评估</text>
  </view>
</view>

<view class="eval-container">
  <view class="eval-title">快速评估您的爱车</view>
  <view class="form-row">
    <text class="form-label">车辆材质</text>
    <picker class="valinput" mode="selector" range="{{evaluateList.materials}}" bindchange="onMaterialChange" value="{{evaluateList.selectedIndex}}">
      <view class="form-picker">
        {{evaluateList.materials[evaluateList.selectedIndex]}}
      </view>
    </picker>
  </view>

  <view class="form-row">
    <text class="form-label">整车质量</text>
    <input class="valinput" type="number" placeholder="请输入整车质量（kg）" bindinput="onWeightInput" value="{{evaluateList.weight}}" />
  </view>
  <view class="eval-note" bind:tap="gotoRecyleInfo">注意：此仅供参考，如需准确价格，请点击</view>
  <button class="eval-btn" bindtap="calculatePrice">快速评估</button>

  <!-- 评估结果显示 -->
  <view class="eval-result" wx:if="{{evaluateList.showResult}}">
    评估价格：¥{{formattedResultPrice}}
  </view>
</view>

<!-- 最新消息（政策卡片，点击跳转详情） -->
<view class="list-container">
  <block wx:for="{{noticeList}}" wx:key="titles">
    <view class="news-header">
      <view class="news-title">
        <view class="news-titlespace"></view>
        <text class="news-titlename">{{item.titles}}</text>
      </view>
      <navigator url="/pages/more/more?category={{item.titles}}" class="news-more">
        更多 >
      </navigator>
    </view>

    <!-- 政策/资讯卡片列表 -->
    <view class="cards-group">
      <block wx:for="{{item.cards}}" wx:key="id">
        <!-- 卡片整体点击（跳详情） -->
        <view class="card" bindtap="onCardTap" data-id="{{item.id}}" data-category="policy">
          <!-- 卡片图片 -->
          <image class="card-img" src="{{item.imgUrl}}" mode="widthFix"></image>
          <!-- 卡片内容 -->
          <view class="card-content">
            <text class="card-title">{{item.title}}</text>

            <view class="card-meta">
              <view class="meta-item">
                <image class="meta-icon" src="/static/icon/calendar.png"></image>
                <text>{{item.date}}</text>
              </view>
              <view class="meta-item">
                <image class="meta-icon" src="/static/icon/eye.png"></image>
                <text>{{item.views}}</text>
              </view>
            </view>

            <text class="card-desc">{{item.desc}}</text>

            <!-- 阅读全文点击（跳详情，阻止冒泡） -->
            <view class="read-more" bindtap="onReadMore" data-id="{{item.id}}" data-category="policy">
              阅读全文 >
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>