.search-wrap {
  padding: 16rpx 26rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #1E293B;
  border-radius: 50rpx;
  padding: 16rpx 34rpx;
  height: 50rpx;
}

.search-icon {
  flex-shrink: 0;
  margin-right: 16rpx;
}


.search-input {
  flex: 1;
  color: #FFFFFF;
  font-size: 30rpx;
  height: 100%;
  min-height: 35rpx;
}

.clear-icon {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.search-input:focus {
  outline: none;
}


/* 轮播组件 */
.banner-wrapper {
  width: 100%;
  height: 380rpx;
  overflow: hidden;
}

.banner-swiper {
  width: calc(100% - 64rpx);
  height: 100%;
  margin: 3rpx auto;
}

.swiper-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 20rpx;
}

.banner-text {
  position: absolute;
  bottom: 0rpx;
  left: 0;
  width: 100%;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(to top,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.2) 60%,
      rgba(0, 0, 0, 0) 100%);
  color: #FFFFFF;
}

.banner-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 14rpx;
  display: block;
}

.banner-desc {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

/* 快捷入口 */
.menu {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 10rpx 16rpx;
  margin: 20rpx 30rpx;
}

.menu-item {
  display: flex;
  flex-wrap: wrap;
  flex-direction: column;
  justify-content: space-around;
  text-align: center;
  align-items: center;
  padding: 10rpx;
  transition: all 0.2s ease;
  width: 25%;
  gap: 20rpx;
}

.menu-backc {
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 30rpx;
  padding: 10rpx;
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  margin: 26rpx;
}

.menu-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.menu-item:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 标题通用样式 */
.news-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 10rpx 0 0 0;
}

.news-titlespace {
  background: linear-gradient(to bottom, #415a77, #778da9);
  width: 15rpx;
  height: 45rpx;
  border-radius: 10rpx;
  margin-left: 20rpx;
}

.news-titlename {
  font-size: 40rpx;
  margin-left: 30rpx;
  font-weight: 700;
  position: relative;
}

/* 车辆评估 */
.eval-container {
  background: linear-gradient(135deg, #1b263b, #1a2538);
  padding: 32rpx;
  margin: 30rpx;
  border-radius: 30rpx;
}

.eval-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: #FFFFFF;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-label {
  width: 130rpx;
  font-size: 28rpx;
  color: #FFFFFF;
}

.form-picker,
input {
  flex: 1;
  padding: 16rpx;
  font-size: 26rpx;
  color: #ffffff;
  border: none;
}

.valinput {
  background-color: #3c4555;
  border-radius: 16rpx;
}

input::placeholder {
  color: #B0B6BE;
}

/* 评估提示文本 */
.eval-note {
  font-size: 26rpx;
  text-align: center;
  margin-bottom: 32rpx;
  opacity: 0.8;
  color: white;
  text-decoration: underline;
  font-weight: bold;
}

/* 评估按钮 */
.eval-btn {
  background: linear-gradient(135deg, #0a0f1d, #121b2d);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  text-align: center;
  border: 1px solid #415a77;
}

.eval-btn:active {
  background: linear-gradient(135deg, #1a2538, #2b3a55);
}

/* 评估结果 */
.eval-result {
  margin-top: 32rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: bold;
  color: #32CD32;
  padding: 16rpx 0;
}

/* 资讯/政策列表容器 */
.list-container {
  background-color: #121C2D;
  padding: 16rpx 0;
  margin-top: 20rpx;
}

.news-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 22rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.news-more {
  display: flex;
  align-items: center;
  color: rgb(119, 141, 169);
  font-size: 28rpx;
  font-weight: normal;
  gap: 8rpx;
}

/* 卡片组 */
.cards-group {
  margin-top: 16rpx;
}

.card {
  background-color: #1E2A3E;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  margin: 20rpx 16rpx;
  transition: all 0.2s ease;
}

.card:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.card-img {
  width: 100%;
  height: auto;
  display: block;
}

.card-content {
  padding: 24rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  display: block;
  line-height: 1.4;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-item text {
  font-size: 24rpx;
  color: #B0BEC5;
}

.card-desc {
  font-size: 26rpx;
  color: #CFD8DC;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
}

.read-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgb(119, 141, 169);
  font-size: 26rpx;
  font-weight: 500;
}

.read-more:active {
  color: #415a77;
}