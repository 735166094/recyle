/* pages/cart/cart.wxss */
page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.cart-container {
  min-height: 100%;
  padding-bottom: 120rpx;
}

/* 空购物车样式 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 50rpx;
}

.go-shopping {
  background-color: #FF6B35;
  color: white;
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 购物车列表样式 */
.cart-list {
  background-color: white;
  margin-top: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1px solid #F5F5F5;
}

.item-check {
  width: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.item-img image {
  width: 100%;
  height: 100%;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-price {
  font-size: 30rpx;
  color: #FF6B35;
  font-weight: bold;
}

.item-count {
  display: flex;
  align-items: center;
  width: 160rpx;
}

.count-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #F5F5F5;
  color: #333;
  font-size: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  touch-action: manipulation;
}

.count-btn.disabled {
  color: #ccc;
  background-color: #F9F9F9;
}

.count-btn.minus {
  margin-right: 10rpx;
}

.count-btn.plus {
  margin-left: 10rpx;
}

.count-number {
  font-size: 28rpx;
  width: 60rpx;
  text-align: center;
}

.item-delete {
  width: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 底部结算栏 */
.cart-footer {
  display: flex;
  align-items: center;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: white;
  border-top: 1px solid #F1F1F1;
  padding: 0 20rpx;
  z-index: 999;
}

.footer-check {
  display: flex;
  align-items: center;
  width: 120rpx;
  font-size: 28rpx;
  color: #333;
}

.footer-check checkbox {
  margin-right: 10rpx;
}

.footer-total {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.total-text {
  font-size: 28rpx;
  color: #333;
  margin-right: 10rpx;
}

.total-price {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: bold;
  margin-right: 10rpx;
}

.total-note {
  font-size: 24rpx;
  color: #999;
}

.footer-pay {
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #FF6B35;
  color: white;
  font-size: 28rpx;
  border-radius: 35rpx;
  margin-left: 20rpx;
}
