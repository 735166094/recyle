.profile-container {
  min-height: 100vh;
  padding: 30rpx 20rpx;
  color: #e0e1dd;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.username {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  display: block;
  text-align: center;
}

.stars {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin: 10rpx 30rpx;
}

.star-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 10rpx;
  gap: 20rpx;
}

.star-number {
  font-size: 40rpx;
  font-weight: 1000;
}

.star-label {
  font-size: 24rpx;
}

.feature-sction {
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
}

.feature-item {
  width: 22%;
  text-align: center;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 24rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 60rpx;
  height: 60rpx;
  margin: 20rpx;
}

.feature-text {
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.feature-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 20rpx 0;
}

.feature-titlespace {
  background: linear-gradient(to bottom, #415a77, #778da9);
  width: 15rpx;
  height: 45rpx;
  border-radius: 10rpx;
}

.feature-titlename {
  font-size: 40rpx;
  margin: 30rpx;
  font-weight: 700;
  position: relative;
}