<view class="container">
  <!-- 页面标题 -->
  <view class="page-title">报废车信息登记</view>

  <!-- 表单容器 -->
  <form bindsubmit="formSubmit" bindreset="formReset" class="form-container">
    <!-- 联系人信息区域 -->
    <view class="form-section">
      <view class="section-title">
        <text>联系人信息</text>
      </view>

      <view class="form-group">
        <label class="form-label required">联系人姓名</label>
        <input class="form-input" name="contactName" placeholder="请输入联系人姓名" required></input>
      </view>

      <view class="form-group">
        <label class="form-label required">联系电话</label>
        <input class="form-input" name="contactPhone" placeholder="请输入联系电话" type="number" required></input>
      </view>

    </view>

    <!-- 车辆信息区域 -->
    <view class="form-section">
      <view class="section-title">
        <text>车辆信息</text>
      </view>

      <view class="form-group">
        <label class="form-label required">车型</label>
        <input class="form-input" name="carModel" placeholder="请输入车型" required></input>
      </view>

      <view class="form-group">
        <label class="form-label">车辆数量</label>
        <input class="form-input" name="carCount" type="number" value="1" min="1"></input>
      </view>

      <view class="form-group">
        <label class="form-label">轮毂类型</label>
        <input class="form-input" name="wheelType" placeholder="请输入轮毂类型"></input>
      </view>

      <view class="form-row">
        <view class="form-group half-width">
          <label class="form-label">轮毂数量</label>
          <input class="form-input" name="wheelCount" type="number" min="0"></input>
        </view>
        <view class="form-group half-width">
          <label class="form-label">三元数量</label>
          <input class="form-input" name="ternaryCount" type="number" min="0"></input>
        </view>
      </view>

      <view class="form-row">
        <view class="form-group half-width">
          <label class="form-label">铅蓄电池数量</label>
          <input class="form-input" name="batteryCount" type="number" min="0"></input>
        </view>
        <view class="form-group half-width">
          <label class="form-label">电池包数量</label>
          <input class="form-input" name="batteryPackCount" type="number" min="0"></input>
        </view>
      </view>

      <view class="form-row">
        <view class="form-group half-width">
          <label class="form-label">发动机数量</label>
          <input class="form-input" name="engineCount" type="number" min="0"></input>
        </view>
        <view class="form-group half-width">
          <label class="form-label">整备质量（吨）</label>
          <input class="form-input" name="weight" type="number" step="0.01" min="0"></input>
        </view>
      </view>

      <view class="form-group">
        <label class="form-label">能否正常启动</label>
        <radio-group name="canStart" class="radioselect">
          <label class="radio-item">
            <radio value="true" checked></radio>
            <text>能</text>
          </label>
          <label class="radio-item">
            <radio value="false"></radio>
            <text>不能</text>
          </label>
        </radio-group>
      </view>

      <view class="form-group">
        <label class="form-label required">车辆照片</label>
        <view class="upload-area">
          <view class="upload-tips">请上传车辆左前方45度拍摄的照片</view>
          <button class="upload-btn" bindtap="chooseImage" type="primary" plain>
            选择照片
          </button>
          <view class="image-preview" wx:if="{{imageUrl}}">
            <image src="{{imageUrl}}" mode="widthFix"></image>
            <button class="delete-img" bindtap="deleteImage" size="mini" type="warn">删除</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 提交按钮区域 -->
    <view class="button-group">
      <button formType="submit" class="submit-btn" disabled="{{!imageUrl}}">
        提交信息
      </button>
      <button formType="reset" class="reset-btn" type="default">
        重置
      </button>
    </view>
  </form>
</view>