/* pages/favorites/favorites.wxss */
page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.favorites-container {
  min-height: 100%;
}

/* 空收藏样式 */
.empty-favorites {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 50rpx;
}

.go-shopping {
  background-color: #FF6B35;
  color: white;
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 收藏列表样式 */
.favorites-list {
  background-color: white;
  margin-top: 20rpx;
}

.favorite-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1px solid #F5F5F5;
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.item-img image {
  width: 100%;
  height: 100%;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-price {
  font-size: 30rpx;
  color: #FF6B35;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.item-sales {
  font-size: 24rpx;
  color: #999;
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.add-to-cart {
  width: 140rpx;
  height: 50rpx;
  line-height: 50rpx;
  background-color: #FFF0E8;
  color: #FF6B35;
  font-size: 24rpx;
  border-radius: 25rpx;
  padding: 0;
}

.remove-favorite {
  width: 140rpx;
  height: 50rpx;
  line-height: 50rpx;
  background-color: #F5F5F5;
  color: #666;
  font-size: 24rpx;
  border-radius: 25rpx;
  padding: 0;
}
