
/* 主容器 */
.auth-container {
  padding: 40rpx;
  min-height: 100vh;
  background: var(--primary);
}

/* 表单区域 */
.form-section {
  margin-top: 40rpx;
}

/* 输入组 */
.input-group {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 30rpx;
  color: var(--light);
  margin-bottom: 20rpx;
}

.input {
  width: 88%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: var(--card-radius);
  padding: 0 40rpx;
  color: var(--light);
  font-size: 26rpx;
  transition: var(--transition);
}

.input:focus {
  border-color: var(--highlight);
  background: rgba(255, 255, 255, 0.1);
}

.input::placeholder {
  color: rgba(255, 255, 255, 0.4);
  font-size: 30rpx;
}

/* 验证码输入组 */
.code-input-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.get-code-btn {
  width: 36%;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, var(--accent), #2a4365);
  color: var(--light);
  border: none;
  border-radius:50rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: var(--transition);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.get-code-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.get-code-btn.disabled {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.4);
  box-shadow: none;
}

/* 标签页样式 */
.tabs {
  display: flex;
  justify-content: space-around;
  margin: 40rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.tab {
  padding: 20rpx 0;
  color: rgba(255, 255, 255, 0.6);
  font-size: 32rpx;
  position: relative;
}

.tab.active {
  color: var(--light);
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: var(--highlight);
}

/* 按钮样式 */
.btn {
  width: 100%;
  height: 100rpx;
  background: var(--accent);
  color: var(--light);
  border: none;
  border-radius: 50rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
  transition: var(--transition);
}

.btn.disabled {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.5);
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 其他选项 */
.other-options {
  background: linear-gradient(135deg, #07c160, #05a050);
  text-align: center;
  margin: 40rpx ;
  padding: 30rpx;
  border-radius: 50rpx;
}

.option-text {
  color: #fff;
  font-size: 28rpx;
}
.btn-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}