/* pages/user/userinfo/userinfo.wxss */
.page-container {
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-left,
.nav-right {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.nav-right text {
  color: #07c160;
  font-size: 30rpx;
}

.icon-back {
  font-size: 36rpx;
  color: #666;
}

.scroll-container {
  height: calc(100vh - 120rpx);
}

/* 分区样式 */
.section {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 0 30rpx;
}

.section-title {
  font-size: 30rpx;
  color: #999;
  padding: 30rpx 0 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

/* 头像编辑 */
.avatar-edit {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 30rpx auto;
  border: 4rpx solid #f0f0f0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.avatar-mask .iconfont {
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

/* 表单样式 */
.form-list {
  padding: 20rpx 0;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  width: 150rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #333;
  padding: 0 20rpx;
}

.form-value {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #666;
}

/* 手机号输入容器 */
.phone-input-container {
  display: flex;
  align-items: center;
  flex: 1;
}

.phone-input {
  flex: 1;
  margin-right: 20rpx;
}

.sms-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 150rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #07c160;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 22rpx;
  padding: 0;
}

.sms-btn.disabled {
  background-color: #ccc;
}

/* 验证码输入框 */
.sms-code-input {
  flex: 1;
}

/* 操作列表 */
.action-list {
  padding: 20rpx 0;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
}

.action-label {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #333;
}

.action-label .iconfont {
  margin-right: 20rpx;
  font-size: 34rpx;
  color: #07c160;
}

.action-arrow .iconfont {
  font-size: 28rpx;
  color: #999;
}

.debug-section {
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 20rpx;
}

