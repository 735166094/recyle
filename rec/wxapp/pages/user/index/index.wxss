.profile-container {
  min-height: 100vh;
  padding: 30rpx 20rpx;
  color: #e0e1dd;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.username {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  display: block;
  text-align: center;
}

.user-info {
  text-align: center;
}

.user-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-top: 10rpx;
}

.guest-tag {
  background: rgba(255, 193, 7, 0.2);
  color: #ffc107;
}

.member-tag {
  background: rgba(76, 175, 80, 0.2);
  color: #4caf50;
}

.logout-btn {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  padding: 20rpx;
}

.logout-btn .iconfont {
  font-size: 36rpx;
  color: #b0bec5;
}


.user-phone {
  font-size: 28rpx;
  color: #b0bec5;
  margin: 10rpx 0;
}

.user-phone:active {
  color: #4fc3f7;
}

.card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx 16rpx;
  margin: 10rpx 30rpx;
}

.card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 10rpx;
  gap: 20rpx;
}

.card-number {
  font-size: 40rpx;
  font-weight: 1000;
}

.card-label {
  font-size: 24rpx;
}

.feature-sction {
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
}

.feature-item {
  width: 22%;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 10rpx 0;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 24rpx;
  display: flex;
  justify-content: space-around;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 15rpx;
}

.feature-text {
  font-size: 26rpx;
  margin: 0 0 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feature-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 20rpx 0;
}

.feature-titlespace {
  background: linear-gradient(to bottom, #415a77, #778da9);
  width: 15rpx;
  height: 45rpx;
  border-radius: 10rpx;
}

.feature-titlename {
  font-size: 40rpx;
  margin: 30rpx;
  font-weight: 700;
  position: relative;
}

.iconfont {
  font-size: 50rpx;
  color: #f5f5f5;
  margin: 0rpx;
}


/* 分享卡片相关样式 */
.share-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.share-card {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
  padding: 30rpx;
  z-index: 999;
}

.share-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
  color: #FFFFFF;
}

.share-preview {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.share-preview .iconfont {
  font-size: 80rpx;
  margin: 0rpx 40rpx;
}

.preview-desc {
  flex: 1;
  margin: 10rpx;
}

.preview-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 10rpx;
}

.preview-subtitle {
  font-size: 24rpx;
  color: #B0BEC5;
}

.share-channels {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
}

.channel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
}

.channel-item .iconfont {
  width: 100rpx;
  height: 100rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  padding: 15rpx;
  margin-bottom: 15rpx;
  display: flex;
  justify-content: center;
}

.channel-name {
  font-size: 24rpx;
  color: #FFFFFF;
}

.btn {
  margin: 30rpx;
  background-color: rgba(255, 255, 255, 0.1);
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 45rpx;
  border: none;
}

.btn:active {
  background-color: rgba(255, 255, 255, 0.5);
  color: #FFFFFF;
}

.feature-item:active,
.feature-item:active,
.channel-item:active {
  transform: scale(0.95);
  opacity: 0.8;
}