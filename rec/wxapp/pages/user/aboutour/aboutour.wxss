.about-page {
  padding: 20rpx;
}

/* 头部横幅 */
.banner {
  position: relative;
  height: 400rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(10, 15, 29, 0.5), rgba(10, 15, 29, 0.9));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 20rpx;
}

.banner-title {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 15rpx;
  color: white;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
}

.banner-subtitle {
  font-size: 28rpx;
  color: #b0b3b8;
  max-width: 600rpx;
}

/* 加载状态 */
.loader {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
  flex-direction: column;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  border-top: 6rpx solid #FF4400;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #b0b3b8;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

/* 内容区域 */
.content {
  padding: 0 10rpx;
}

.section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10rpx);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #FF4400;
  display: flex;
  align-items: center;
}

.section-title .iconfont {
  margin-right: 15rpx;
  color: #FF4400;
  font-size: 34rpx;
}

/* 公司简介 */
.intro-text {
  text-indent: 2em;
  margin-bottom: 30rpx;
  color: #b0b3b8;
  line-height: 1.8;
  font-size: 28rpx;
}

.stats-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 30rpx;
}

.stat-item {
  width: 48%;
  background: rgba(255, 255, 255, 0.08);
  padding: 25rpx;
  border-radius: 15rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF4400;
  margin-bottom: 10rpx;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #b0b3b8;
}

/* 发展历程 */
.timeline {
  position: relative;
  padding-left: 40rpx;
  margin-left: 10rpx;
}

.timeline-line {
  position: absolute;
  left: 15rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 4rpx;
  background: #FF4400;
  border-radius: 3rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 40rpx;
  padding-left: 30rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -38rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #FF4400;
  border: 4rpx solid #0a0f1d;
}

.timeline-year {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF4400;
  margin-bottom: 10rpx;
  display: block;
}

.timeline-event {
  font-size: 26rpx;
  color: #b0b3b8;
  line-height: 1.6;
}

/* 企业理念 */
.principles-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.principle-item {
  width: 48%;
  background: rgba(255, 255, 255, 0.08);
  padding: 30rpx 20rpx;
  border-radius: 15rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.principle-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 68, 0, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.principle-icon .iconfont {
  color: #FF4400;
  font-size: 36rpx;
}

.principle-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 15rpx;
  display: block;
}

.principle-desc {
  font-size: 24rpx;
  color: #b0b3b8;
  line-height: 1.6;
}

/* 联系我们 */
.contact-info {
  margin-top: 20rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  width: 40rpx;
  color: #FF4400;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.contact-text {
  flex: 1;
  color: #b0b3b8;
  font-size: 28rpx;
  word-break: break-all;
}

/* 返回顶部按钮 */
.back-to-top {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 80rpx;
  height: 80rpx;
  background: #FF4400;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 68, 0, 0.4);
  z-index: 1000;
  opacity: 0.9;
}

.back-to-top:active {
  opacity: 1;
  transform: scale(0.95);
}

.up-icon {
  font-size: 36rpx;
}

/* 响应式设计 */
@media (max-width: 600rpx) {

  .stats-container,
  .principles-grid {
    flex-direction: column;
  }

  .stat-item,
  .principle-item {
    width: 100%;
  }

  .banner-title {
    font-size: 36rpx;
  }

  .section {
    padding: 25rpx;
  }
}