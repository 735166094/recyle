/* pages/user/change_password/change_password.wxss */
.page-container {
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-left, .nav-right {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.icon-back {
  font-size: 36rpx;
  color: #666;
}

.scroll-container {
  height: calc(100vh - 120rpx);
}

/* 表单区域 */
.form-section {
  background-color: #fff;
  margin-bottom: 20rpx;
}

.form-list {
  padding: 20rpx 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  width: 200rpx;
}

/* 输入框容器 */
.input-container {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.form-input {
  flex: 1;
  text-align: left;
  font-size: 30rpx;
  color: #333;
  padding: 0 80rpx 0 20rpx;
  height: 60rpx;
  line-height: 60rpx;
}

/* 错误输入框样式 */
.input-container.error-input {
  border-bottom: 2rpx solid #ff4d4f;
}

/* 眼睛图标 */
.eye-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  z-index: 2;
}

.eye-icon .iconfont {
  font-size: 32rpx;
}

.eye-icon:active {
  background-color: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
}

/* 密码验证错误提示 */
.validation-tip {
  position: absolute;
  right: 0;
  bottom: -40rpx;
  display: flex;
  align-items: center;
  opacity: 0;
  transform: translateY(10rpx);
  transition: all 0.3s ease;
}

.validation-tip.show {
  opacity: 1;
  transform: translateY(0);
}

.validation-tip .iconfont {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-right: 8rpx;
}

.validation-text {
  font-size: 24rpx;
  color: #ff4d4f;
}

/* 密码不一致提示 */
.match-tip {
  position: absolute;
  right: 10rpx;
  bottom: -20rpx;
  display: flex;
  align-items: center;
  opacity: 0;
  transform: translateY(10rpx);
  transition: all 0.3s ease;
}

.match-tip.show {
  opacity: 1;
  transform: translateY(0);
}

.match-tip .iconfont {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-right: 8rpx;
}

.match-text {
  font-size: 24rpx;
  color: #ff4d4f;
}

/* 密码要求 */
.password-requirements {
  padding: 30rpx;
  background-color: #f8f9fa;
  margin: 20rpx 30rpx;
  border-radius: 10rpx;
}

.requirement-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.requirement-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.requirement-item.valid {
  color: #07c160;
}

.requirement-item .iconfont {
  margin-right: 15rpx;
  font-size: 24rpx;
}

.requirement-item.valid .icon-check {
  color: #07c160;
}

.requirement-item .icon-circle {
  color: #ccc;
}

/* 密码强度 */
.password-strength {
  padding: 30rpx;
  background-color: #fff;
  margin: 20rpx 30rpx;
  border-radius: 10rpx;
}

.strength-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.strength-bar {
  display: flex;
  gap: 8rpx;
  margin-bottom: 15rpx;
}

.strength-segment {
  flex: 1;
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
}

.strength-segment.weak {
  background-color: #ff4d4f;
}

.strength-segment.medium {
  background-color: #faad14;
}

.strength-segment.strong {
  background-color: #52c41a;
}

.strength-segment.very-strong {
  background-color: #1890ff;
}

.strength-text {
  font-size: 26rpx;
  text-align: center;
}

.strength-text.weak {
  color: #ff4d4f;
}

.strength-text.medium {
  color: #faad14;
}

.strength-text.strong {
  color: #52c41a;
}

.strength-text.very-strong {
  color: #1890ff;
}

/* 提交按钮 */
.submit-section {
  padding: 40rpx 30rpx;
}

.submit-btn {
  width: 100%;
  padding: 25rpx 0;
  background-color: #f0f0f0;
  color: #999;
  border-radius: 50rpx;
  font-size: 32rpx;
  border: none;
}

.submit-btn.active {
  background-color: #07c160;
  color: #fff;
}

.submit-btn.active:active {
  background-color: #06a953;
}
/* 提示信息样式 */
.tip-section {
  padding: 30rpx;
  background: linear-gradient(135deg, #e6f7ff 0%, #f0fdff 100%);
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  border-left: 8rpx solid #1890ff;
  box-shadow: 0 4rpx 20rpx rgba(24, 144, 255, 0.1);
  position: relative;
  overflow: hidden;
}

.tip-section::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(24, 144, 255, 0.05);
  border-radius: 50%;
  z-index: 0;
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.tip-header .iconfont {
  font-size: 32rpx;
  color: #1890ff;
  margin-right: 12rpx;
}

.tip-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1890ff;
}

.tip-content {
  position: relative;
  z-index: 1;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.5;
  padding: 8rpx 0;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-item .iconfont {
  margin-right: 15rpx;
  font-size: 24rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.tip-item .icon-warning {
  color: #faad14;
}

.tip-item .icon-info {
  color: #1890ff;
}

.tip-item .icon-lock {
  color: #52c41a;
}

.tip-text {
  flex: 1;
  line-height: 1.6;
}

/* 动画效果 */
.tip-section {
  animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 响应式调整 */
@media (max-width: 375px) {
  .tip-section {
    margin: 20rpx 20rpx;
    padding: 24rpx;
  }
  
  .tip-item {
    font-size: 24rpx;
  }
}