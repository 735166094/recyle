<!-- pages/user/change_password/change_password.wxml -->
<view class="page-container">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-left" bindtap="navBack">
      <text class="iconfont icon-back"></text>
    </view>
    <view class="nav-title">修改密码</view>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="scroll-container" scroll-y>
    <!-- 密码表单 -->
    <view class="form-section">
      <view class="form-list">
        <!-- 旧密码 -->
        <view class="form-item">
          <view class="form-label">旧密码</view>
          <view class="input-container">
            <input class="form-input" password="{{!showOldPassword}}" type="text" placeholder="请输入当前密码" value="{{oldPassword}}" bindinput="onOldPasswordInput" />
            <view class="eye-icon" bindtap="toggleOldPasswordVisibility">
              <text class="iconfont {{showOldPassword ? 'icon-eye' : 'icon-closeeye'}}"></text>
            </view>
          </view>
        </view>

        <!-- 新密码 -->
        <view class="form-item">
          <view class="form-label">新密码</view>
          <view class="input-container {{passwordValidationError ? 'error-input' : ''}}">
            <input class="form-input" password="{{!showNewPassword}}" type="text" placeholder="请输入新密码（至少6位）" value="{{newPassword}}" bindinput="onNewPasswordInput" />
            <view class="eye-icon" bindtap="toggleNewPasswordVisibility">
              <text class="iconfont {{showNewPassword ? 'icon-eye' : 'icon-closeeye'}}"></text>
            </view>
          </view>
          <!-- 密码验证错误提示 -->
          <view class="validation-tip {{passwordValidationError ? 'show' : ''}}">
            <text class="iconfont icon-warning"></text>
            <text class="validation-text">{{passwordValidationError}}</text>
          </view>
        </view>

        <!-- 确认新密码 -->
        <view class="form-item">
          <view class="form-label">确认新密码</view>
          <view class="input-container {{passwordMatchError ? 'error-input' : ''}}">
            <input class="form-input" password="{{!showNewPasswordConfirm}}" type="text" placeholder="请再次输入新密码" value="{{newPasswordConfirm}}" bindinput="onNewPasswordConfirmInput" />
            <view class="eye-icon" bindtap="toggleNewPasswordConfirmVisibility">
              <text class="iconfont {{showNewPasswordConfirm ? 'icon-eye' : 'icon-closeeye'}}"></text>
            </view>
          </view>
          <!-- 密码不一致提示 -->
          <view class="match-tip {{passwordMatchError ? 'show' : ''}}">
            <text class="iconfont icon-warning"></text>
            <text class="match-text">两次输入的密码不一致</text>
          </view>
        </view>
      </view>

      <!-- 密码要求提示 -->
      <view class="password-requirements">
        <view class="requirement-title">密码建议要求：</view>
        <view class="requirement-item {{passwordStrength.length ? 'valid' : ''}}">
          <text class="iconfont {{passwordStrength.length ? 'icon-yes' : 'icon-close'}}"></text>
          <text>至少6个字符</text>
        </view>

        <view class="requirement-item {{passwordStrength.hasUpper ? 'valid' : ''}}">
          <text class="iconfont {{passwordStrength.hasUpper ? 'icon-yes' : 'icon-close'}}"></text>
          <text>包含大写字母</text>
        </view>
        <view class="requirement-item {{passwordStrength.hasLower ? 'valid' : ''}}">
          <text class="iconfont {{passwordStrength.hasLower ? 'icon-yes' : 'icon-close'}}"></text>
          <text>包含小写字母</text>
        </view>
        <view class="requirement-item {{passwordStrength.hasNumber ? 'valid' : ''}}">
          <text class="iconfont {{passwordStrength.hasNumber ? 'icon-yes' : 'icon-close'}}"></text>
          <text>包含数字</text>
        </view>
        <view class="requirement-item {{passwordStrength.hasSpecial ? 'valid' : ''}}">
          <text class="iconfont {{passwordStrength.hasSpecial ? 'icon-yes' : 'icon-close'}}"></text>
          <text>包含特殊字符</text>
        </view>
      </view>

      <!-- 密码强度显示 -->
      <view class="password-strength">
        <view class="strength-label">密码强度：</view>
        <view class="strength-bar">
          <view class="strength-segment {{passwordStrength.level >= 1 ? strengthClass : ''}}"></view>
          <view class="strength-segment {{passwordStrength.level >= 2 ? strengthClass : ''}}"></view>
          <view class="strength-segment {{passwordStrength.level >= 3 ? strengthClass : ''}}"></view>
          <view class="strength-segment {{passwordStrength.level >= 4 ? strengthClass : ''}}"></view>
        </view>
        <view class="strength-text {{strengthClass}}">{{passwordStrength.text}}</view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-btn {{canSubmit ? 'active' : ''}}" bindtap="submitChangePassword" disabled="{{!canSubmit}}">
        确认修改
      </button>
    </view>

    <!-- 修改密码提示信息 -->
    <view class="tip-section">
      <view class="tip-header">
        <text class="iconfont icon-tip"></text>
        <text class="tip-title">重要提示</text>
      </view>
      <view class="tip-content">
        <view class="tip-item">
          <text class="iconfont icon-warning"></text>
          <text class="tip-text">修改密码后需要重新登录</text>
        </view>
        <view class="tip-item">
          <text class="iconfont icon-user"></text>
          <text class="tip-text">请确保新密码符合安全要求</text>
        </view>
        <view class="tip-item">
          <text class="iconfont icon-lock"></text>
          <text class="tip-text">建议定期更换密码以保证账户安全</text>
        </view>
      </view>
    </view>
  </scroll-view>

</view>