<view class="profile-container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-left" bindtap="navBack">
      <text class="iconfont icon-back"></text>
    </view>
    <view class="nav-title">个人信息</view>
    <view class="nav-right" bindtap="editProfile">
      <text>编辑</text>
    </view>
  </view>

  <!-- 头像区域 -->
  <view class="avatar-section">
    <view class="avatar-wrapper" bindtap="chooseAvatar">
      <image class="avatar-img" src="{{userInfo.avatar || '/static/tabbar/my-active.png'}}" mode="cover"></image>
    </view>
    <view class="user-name">{{userInfo.name || '未设置'}}</view>
    <view class="user-role">{{userInfo.role || '普通用户'}}</view>
  </view>

  <!-- 信息列表 -->
  <view class="info-list">
    <view class="info-item">
      <view class="info-label">
        <text class="iconfont icon-user"></text>
        <text>用户名</text>
      </view>
      <view class="info-value">{{userInfo.username || '未设置'}}</view>
    </view>

    <view class="info-item">
      <view class="info-label">
        <text class="iconfont icon-phone"></text>
        <text>手机号</text>
      </view>
      <view class="info-value">{{userInfo.phone || '未绑定'}}</view>
    </view>

    <view class="info-item">
      <view class="info-label">
        <text class="iconfont icon-user"></text>
        <text>工号</text>
      </view>
      <view class="info-value">{{userInfo.employeeId || '未设置'}}</view>
    </view>

    <view class="info-item">
      <view class="info-label">
        <text class="iconfont icon-history"></text>
        <text>注册时间</text>
      </view>
      <view class="info-value">{{userInfo.registerTime || '未知'}}</view>
    </view>

  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="action-btn bind-btn" bindtap="bindWechat">
      <text class="iconfont icon-wechat"></text>
      <text>绑定微信</text>
    </button>
    <button class="action-btn logout-btn" bindtap="logout">
      <text class="iconfont icon-logout"></text>
      <text>退出登录</text>
    </button>
  </view>
</view>