/* 基础样式 */
.page-container {
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-left, .nav-right {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.nav-right text {
  color: #07c160;
  font-size: 30rpx;
}

.icon-back {
  font-size: 36rpx;
  color: #666;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.avatar-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 30rpx;
  border: 4rpx solid #f0f0f0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}



.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.user-role {
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 5rpx 20rpx;
  border-radius: 20rpx;
}

/* 信息列表 */
.info-list {
  background-color: #fff;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-label {
  display: flex;
  align-items: center;
  color: #666;
  font-size: 30rpx;
}

.info-label .iconfont {
  margin-right: 20rpx;
  font-size: 34rpx;
  color: #07c160;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

/* 操作按钮 */
.action-buttons {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 15rpx 0;
  border-radius: 20rpx;
  font-size: 32rpx;
  border: none;
}

.bind-btn {
  background-color: #f5f5f5;
  color: #333;
}

.logout-btn {
  background-color: #ff4d4f;
  color: #fff;
}

.action-btn .iconfont {
  margin-right: 15rpx;
  font-size: 34rpx;
}