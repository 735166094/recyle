/* pages/ocr/settings/settings.wxss */
.setting-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 20rpx;
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 15rpx;
}

.setting-label {
  flex: 1;
}

.label-text {
  font-size: 34rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.label-desc {
  font-size: 26rpx;
  color: #999;
}

.setting-switch {
  transform: scale(1.2);
}

.cache-info {
  display: flex;
  align-items: center;
  color: #999;
}

.cache-size {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.version-text {
  font-size: 28rpx;
  color: #07C160;
}

.setting-hint {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #fff8e6;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.hint-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
  color: #e67e22;
}

.hint-text {
  font-size: 26rpx;
  color: #e67e22;
  line-height: 1.5;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-container {
  background-color: white;
  border-radius: 20rpx;
  width: 600rpx;
  max-width: 90vw;
  overflow: hidden;
}

.modal-header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-content {
  padding: 0 30rpx 40rpx;
}

.modal-text {
  font-size: 32rpx;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
  text-align: center;
}

.modal-subtext {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 30rpx;
  text-align: center;
}

.clear-list {
  margin-top: 20rpx;
}

.clear-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.clear-item:last-child {
  border-bottom: none;
}

.clear-item .iconfont {
  margin-right: 15rpx;
  font-size: 24rpx;
}

.clear-text {
  font-size: 26rpx;
  color: #333;
}

.modal-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  padding: 30rpx 0;
  border: none;
  border-radius: 0;
  font-size: 32rpx;
  background: none;
}

.modal-btn-cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn-confirm {
  color: #07C160;
  font-weight: bold;
}

.modal-btn:active {
  background-color: #f8f8f8;
}

/* 进度条样式 */
.progress-container {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #07C160, #09BB07);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  width: 80rpx;
  text-align: center;
}

.progress-status {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  display: block;
}