/* 搜索栏样式 */
.search-bar {
  padding: 16rpx 24rpx 0rpx;
  background: linear-gradient(135deg, #0a0f1d, #121b2d);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 0rpx;
  border: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

.search-input {
  display: flex;
  align-items: center;
  background-color: #1E293B;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  flex: 1;
  margin-right: 16rpx;
  border: 1px solid rgba(119, 141, 169, 0.3);

}


.placeholder-style {
  color: var(--highlight);
  font-size: 28rpx;
}

.search-input input {
  margin-left: 16rpx;
  flex: 1;
  color: #FFFFFF;
  font-size: 28rpx;
  height: 40rpx;
  background: transparent;
  border: none;
}

.search-input input:focus {
  outline: none;
}

/* UI切换按钮 */
.ui-toggle {
  /* color: #3a7bd5; */
  color: var(--highlight);
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  border: 1px solid var(--highlight);
  border-radius: 20rpx;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.ui-toggle:active {
  background-color: rgba(58, 123, 213, 0.2);
}


/* 分类标签样式 */
.category-scroll {
  width: 100%;
  background: linear-gradient(135deg, #0a0f1d, #121b2d);
  padding: 16rpx 0;
  position: sticky;
  top: 80rpx;
  z-index: 9;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

.category-wrapper {
  display: flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.category-item {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  background-color: #1E293B;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.category-item.active {
  color: #fff;
  background: var(--accent);

}

.category-item:active {
  transform: scale(0.95);
}


/* 模式1：卡片样式 */
.list-container {
  padding: 6rpx;
}

.cards-group {
  display: flex;
  flex-direction: column;
  padding: 10rpx;
  gap: 20rpx;
}

.cards {
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
  transition: all 0.2s ease;
}

.cards:active {
  transform: scale(0.99);
  box-shadow: 0 1rpx 5rpx rgba(0, 0, 0, 0.2);
}

.card-img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

.card-content {
  padding: 20rpx;
}

.card-title {
  font-size: 30rpx;
  color: #ffffff;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.meta-item .iconfont {
  font-size: 36rpx;
  color: var(--highlight);
}

.card-desc {
  font-size: 26rpx;
  color: #CFD8DC;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

/* 活动状态标签 */
.activity-status {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.activity-status.ongoing {
  background-color: rgba(15, 157, 88, 0.2);
  color: #0f9d58;
}

.activity-status.upcoming {
  background-color: rgba(244, 160, 0, 0.2);
  color: #f4a000;
}

.read-more {
  font-size: 26rpx;
  color: var(--accent);
  transition: all 0.2s ease;
}

.read-more:active {
  color: #415a77;
}

/* 模式2：列表样式 */
.activity-list {
  padding: 20rpx 30rpx;
}

.activity-item {
  display: flex;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
  transition: all 0.2s ease;
}

.activity-item:active {
  transform: scale(0.99);
  box-shadow: 0 1rpx 5rpx rgba(0, 0, 0, 0.2);
}

.activity-image {
  width: 200rpx;
  height: 160rpx;
  flex-shrink: 0;
  position: relative;
}

.activity-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 状态标签 */
.status-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.status-badge.ongoing {
  background-color: rgba(15, 157, 88, 0.9);
  color: #fff;
}

.status-badge.upcoming {
  background-color: rgba(244, 160, 0, 0.9);
  color: #fff;
}

.activity-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-title {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.activity-participants {
  color: #3a7bd5;
}


/* 加载提示样式 */
.loading-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  color: #888;
  font-size: 28rpx;
}

.loading-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #eee;
  border-radius: 50%;
  border-top-color: #3a7bd5;
  animation: spin 1s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #888;
  font-size: 28rpx;
}
