/* 基础样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.cart-container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部样式 */
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rpx 30rpx;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.address {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--light);
}

.address .iconfont {
  font-size: 30rpx;
  margin-right: 10rpx;
  color: var(--light);
}

.address:active {
  opacity: 0.8;
}

.edit-btn {
  font-size: 26rpx;
  color: var(--light);
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  transition: all 0.2s;
}

.edit-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-container .iconfont {
  font-size: 60rpx;
  color: var(--light);
  animation: rotate 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes rotate {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

/* 商品列表样式 */
.cart-list {
  padding-bottom: 140rpx;
  margin-top: 20rpx;
}

/* 滑动操作相关样式 */
.movable-area {
  width: 100%;
  height: 240rpx;
  margin-bottom: 15rpx;
  overflow: hidden;
}

.movable-view {
  width: calc(100% + 450rpx);
  height: 240rpx;
  display: flex;
}

.cart-item {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 20rpx;
  margin: 0 10rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  position: relative;
}

/* 修复复选框 - 使用更大的点击区域 */
.item-checkbox {
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 确保复选框容器可以点击 */
.item-checkbox {
  position: relative;
  z-index: 10;
}

/* 修复复选框样式 */
.cart-checkbox {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

/* 重置小程序默认checkbox样式 */
.cart-checkbox .wx-checkbox-input {
  width: 40rpx !important;
  height: 40rpx !important;
  border-radius: 50% !important;
  border: 2rpx solid #ccc !important;
  background: transparent !important;
}

.cart-checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background: #165DFF !important;
  border-color: #165DFF !important;
}

.cart-checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  width: 20rpx !important;
  height: 10rpx !important;
  border: 2rpx solid #fff !important;
  border-top: 0 !important;
  border-right: 0 !important;
  transform: rotate(-45deg) !important;
  top: 50% !important;
  left: 50% !important;
  margin-left: -10rpx !important;
  margin-top: -6rpx !important;
  content: '' !important;
  position: absolute !important;
}

.item-image {
  width: 180rpx;
  height: 180rpx;
  margin: 0 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.goods-img {
  width: 100%;
  height: 100%;
  display: block;
}

.goods-status-tag {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

/* 修复商品信息区域布局 */
.item-info {
  flex: 1;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  /* 防止flex溢出 */
}

.info-content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--light);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  max-height: 80rpx;
  margin-bottom: 8rpx;
}

.item-spec {
  font-size: 24rpx;
  color: #86909C;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  max-height: 32rpx;
}

.info-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 10rpx;
}

.price-section {
  display: flex;
  align-items: center;
  flex: 1;
}

.current-price {
  font-size: 32rpx;
  color: #F53F3F;
  font-weight: 600;
}

.original-price {
  font-size: 24rpx;
  color: #86909C;
  text-decoration: line-through;
  margin-left: 12rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background-color: rgba(255, 255, 255, 0.1);
  font-size: 36rpx;
  color: var(--light);
  box-sizing: border-box;
  touch-action: manipulation;
}

.quantity-btn.minus {
  border-right: none;
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

.quantity-btn.plus {
  border-left: none;
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}

.quantity-btn.disabled {
  color: #86909C;
  background-color: rgba(255, 255, 255, 0.05);
  pointer-events: none;
}

.quantity-btn:not(.disabled):active {
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.quantity-number {
  width: 70rpx;
  height: 56rpx;
  line-height: 54rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 28rpx;
  color: var(--light);
  box-sizing: border-box;
  background-color: rgba(255, 255, 255, 0.05);
}

/* 滑动操作按钮 */
.slide-actions {
  display: flex;
  height: 100%;
}

.action-btn {
  width: 150rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
}

.action-btn .iconfont {
  font-size: 36rpx;
  margin-bottom: 8rpx;
  margin-right: 0;
}

.action-btn.collect {
  background-color: #00B42A;
}

.action-btn.similar {
  background-color: #FF7D00;
}

.action-btn.delete {
  background-color: #F53F3F;
}

/* 空购物车样式 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 70vh;
  padding: 0 30rpx;
  text-align: center;
}

.empty-cart .iconfont {
  font-size: 160rpx;
  color: rgba(255, 255, 255, 0.1);
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 34rpx;
  color: var(--light);
  margin-bottom: 15rpx;
}

.empty-subtext {
  font-size: 28rpx;
  color: #86909C;
  margin-bottom: 60rpx;
}

.go-shopping {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  text-align: center;
}

.go-shopping:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 底部结算栏 */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 0 30rpx;
  box-sizing: border-box;
  z-index: 99;
}

.footer-select-all {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 10;
}

/* 修复底部复选框样式 */
.footer-checkbox {
  margin-right: 12rpx;
  position: relative;
}

.footer-checkbox .wx-checkbox-input {
  width: 36rpx !important;
  height: 36rpx !important;
  border-radius: 50% !important;
  border: 2rpx solid #ccc !important;
  background: transparent !important;
}

.footer-checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background: #165DFF !important;
  border-color: #165DFF !important;
}

.footer-checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  width: 18rpx !important;
  height: 9rpx !important;
  border: 2rpx solid #fff !important;
  border-top: 0 !important;
  border-right: 0 !important;
  transform: rotate(-45deg) !important;
  top: 50% !important;
  left: 50% !important;
  margin-left: -9rpx !important;
  margin-top: -5rpx !important;
  content: '' !important;
  position: absolute !important;
}

.select-all-text {
  font-size: 28rpx;
  color: var(--light);
}

.selected-count {
  font-size: 24rpx;
  color: #86909C;
  margin-left: 10rpx;
}

.footer-total {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.total-text {
  font-size: 28rpx;
  color: var(--light);
  margin-right: 10rpx;
}

.total-price {
  font-size: 34rpx;
  color: #F53F3F;
  font-weight: 600;
  margin-right: 10rpx;
}

.total-quantity {
  font-size: 24rpx;
  color: #86909C;
}

.btn {
  width: 180rpx;
  height: 70rpx;
  line-height: 70rpx;
  background: linear-gradient(135deg, var(--accent), #2a4365);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 35rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(58, 110, 165, 0.3);
}

.btn.disabled {
  background: rgba(255, 255, 255, 0.1);
  box-shadow: none;
  color: #86909C;
  pointer-events: none;
}

.btn:not(.disabled):active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cart-item {
  animation: fadeIn 0.3s ease-in-out;
}

.movable-view {
  transition: transform 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}