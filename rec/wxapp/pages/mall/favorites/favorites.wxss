/* 页面容器 */
.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
}

/* 空收藏状态 */
.empty-favorites {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 70vh;
  text-align: center;
  padding: 0 60rpx;
}

.empty-text {
  font-size: 36rpx;
  color: var(--light);
  margin: 40rpx 0 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: rgba(224, 225, 221, 0.6);
  margin-bottom: 60rpx;
  line-height: 1.6;
  max-width: 80%;
}

/*按钮样式冲突  */
.empty-favorites .btn-primary {
  background: linear-gradient(135deg, var(--accent), #2a4365);
  color: var(--light);
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(58, 110, 165, 0.3);
  transition: var(--transition);
  margin: 20rpx auto;
  display: block;
  width: 200rpx;
  height: auto;
  line-height: normal;
}

.empty-favorites .btn-primary::after {
  border: none;
}

.empty-favorites .btn-primary:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 12rpx rgba(58, 110, 165, 0.3);
  opacity: 0.9;
}

/* 操作栏样式 */
.action-bar {
  background: linear-gradient(135deg, var(--secondary), #1a2538);
  border-radius: var(--card-radius);
  box-shadow: var(--shadow);
  border: 1px solid rgba(119, 141, 169, 0.2);
  margin: 20rpx 0 30rpx;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  backdrop-filter: blur(10px);
}

.select-all {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.select-all checkbox {
  transform: scale(0.9);
}

.select-all .wx-checkbox-input {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2px solid rgba(224, 225, 221, 0.4);
}

.select-all .wx-checkbox-input.wx-checkbox-input-checked {
  background: var(--accent);
  border-color: var(--accent);
}

.select-all .wx-checkbox-input.wx-checkbox-input-checked::before {
  font-size: 24rpx;
  color: var(--light);
  line-height: 36rpx;
}

.select-text {
  font-size: 28rpx;
  color: var(--light);
  font-weight: 500;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

/* 操作按钮样式 */
.action-btn {
  padding: 18rpx 28rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  transition: var(--transition);
  background: linear-gradient(135deg, var(--accent), #2a4365);
  color: var(--light);
  box-shadow: 0 6rpx 20rpx rgba(58, 110, 165, 0.3);
  min-width: 120rpx;
  text-align: center;
  line-height: normal;
  height: auto;
}

.action-btn.delete {
  background: linear-gradient(135deg, rgba(231, 76, 60, 0.9), rgba(192, 57, 43, 0.8));
  color: #ffffff;
  border: 1px solid rgba(231, 76, 60, 0.3);
  box-shadow: 0 6rpx 20rpx rgba(231, 76, 60, 0.2);
}

.action-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
  opacity: 0.9;
}

.action-btn[disabled] {
  background: rgba(27, 38, 59, 0.6);
  color: rgba(224, 225, 221, 0.4);
  border: 1px solid rgba(119, 141, 169, 0.2);
  box-shadow: none;
  opacity: 0.6;
}

/* 收藏列表样式 */
.favorites-list {
  margin-bottom: 30rpx;
}

.favorites-item {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--secondary), #1a2538);
  border-radius: var(--card-radius);
  box-shadow: var(--shadow);
  border: 1px solid rgba(119, 141, 169, 0.2);
  padding: 28rpx;
  margin-bottom: 24rpx;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.favorites-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  transition: left 0.6s;
}

.favorites-item:active::before {
  left: 100%;
}

.favorites-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.3);
}

/* 调整商品项复选框大小 */
.item-checkbox {
  margin-right: 24rpx;
  transform: scale(0.85);
}

.item-checkbox .wx-checkbox-input {
  width: 34rpx;
  height: 34rpx;
  border-radius: 6rpx;
  border: 2px solid rgba(224, 225, 221, 0.4);
}

.item-checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background: var(--accent);
  border-color: var(--accent);
}

.item-checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  font-size: 22rpx;
  color: var(--light);
  line-height: 34rpx;
}

.item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  margin-right: 28rpx;
  object-fit: cover;
  border: 2px solid rgba(119, 141, 169, 0.3);
  transition: var(--transition);
}

.item-image:active {
  border-color: var(--accent);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 140rpx;
  justify-content: center;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--light);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-desc {
  font-size: 26rpx;
  color: rgba(224, 225, 221, 0.7);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.price-icon-point{
  font-size: 36rpx;
}

.points {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  color: red;
}

.points-unit {
  font-size: 24rpx;
  color: rgba(224, 225, 221, 0.6);
  margin-left: 6rpx;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  background: linear-gradient(135deg, rgba(65, 90, 119, 0.4), rgba(41, 67, 100, 0.4));
  color: rgba(224, 225, 221, 0.9);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  border: 1px solid rgba(119, 141, 169, 0.3);
  backdrop-filter: blur(5px);
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-left: 20rpx;
}

/* 小按钮样式冲突 */
.action-btn-small {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(27, 38, 59, 0.9), rgba(41, 67, 100, 0.8));
  border: 1px solid rgba(119, 141, 169, 0.3);
  color: var(--light);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  padding: 0;
  line-height: normal;
}

.action-btn-small.delete {
  background: linear-gradient(135deg, rgba(231, 76, 60, 0.9), rgba(192, 57, 43, 0.8));
  border-color: rgba(231, 76, 60, 0.3);
  color: #ffffff;
}

.action-btn-small:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
  opacity: 0.9;
}

.action-btn-small .iconfont {
  font-size: 32rpx;
  margin: 0;
}

/* 推荐商品区域 */
.recommend-section {
  margin-top: 50rpx;
  padding-bottom: 40rpx;
}

.recommend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 30rpx;
}

.recommend-item {
  width: calc(50% - 12rpx);
  background: linear-gradient(135deg, var(--secondary), #1a2538);
  border-radius: var(--card-radius);
  box-shadow: var(--shadow);
  border: 1px solid rgba(119, 141, 169, 0.2);
  overflow: hidden;
  transition: var(--transition);
}

.recommend-item:active {
  transform: translateY(4rpx);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

.recommend-image {
  width: 100%;
  height: 220rpx;
  object-fit: cover;
  border-bottom: 1px solid rgba(119, 141, 169, 0.2);
}

.recommend-info {
  padding: 24rpx;
}

.recommend-title {
  font-size: 28rpx;
  color: var(--light);
  font-weight: 600;
  margin-bottom: 16rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 80rpx;
}

.recommend-price {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 8rpx;
}

.recommend-price .points {
  font-size: 32rpx;
  color: var(--gold);
  font-weight: 700;
}

.recommend-price .points-unit {
  font-size: 24rpx;
  color: rgba(224, 225, 221, 0.6);
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .container {
    padding: 20rpx 24rpx;
  }

  .favorites-item {
    padding: 24rpx;
  }

  .item-image {
    width: 120rpx;
    height: 120rpx;
  }

  .item-title {
    font-size: 28rpx;
  }

  .action-btn {
    padding: 16rpx 24rpx;
    font-size: 24rpx;
  }

  .action-btn-small {
    width: 60rpx;
    height: 60rpx;
  }

  .action-btn-small .iconfont {
    font-size: 28rpx;
  }
}