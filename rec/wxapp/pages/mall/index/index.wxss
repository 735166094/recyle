  font-size: 32rpx;
  font-weight: bold;
  margin-left: 8rpx;
}

.search-good-meta {
  display: flex;
  gap: 20rpx;
}

.search-good-sales,
.search-good-stock {
  font-size: 24rpx;
  color: #94A3B8;
}

.search-good-actions {
  margin-left: 20rpx;
}

.search-cart-icon {
  font-size: 44rpx;
  color: #e0e7ff;
}

.no-data {
  text-align: center;
  padding: 100rpx 0;
}

.no-data-text {
  display: block;
  font-size: 32rpx;
  color: #94A3B8;
  margin-bottom: 16rpx;
}

.no-data-desc {
  display: block;
  font-size: 28rpx;
  color: #64748B;
}

.hot-items {
  margin: 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
}

.hot-item {
  width: 100%;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 20rpx;
  overflow: hidden;
  gap: 20rpx;
}

.hot-card {
  width: 100%;
  margin-top: 0%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.hot-img {
  width: 100%;
  height: 350rpx;
  object-fit: cover;
}

.hot-title {
  padding: 14rpx 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 热门商品价格区域  */
.hot-price {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  padding: 0 20rpx 20rpx !important;
  font-weight: bold;
}

.hot-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.price-icon-point {
  font-size: 28rpx !important;
  color: #FF6B6B !important;
  margin-right: 6rpx !important;
  vertical-align: middle;
}

.hot-pricetext {
  font-size: 32rpx;
  color: #FF6B6B;
}

/* 购物车图标 */
.hot-price .icon-cart {
  font-size: 44rpx;
  color: #e0e7ff;
  margin-left: 20rpx;
  position: static !important;
  right: auto !important;
  bottom: auto !important;
  transform: none !important;
}

.good-items {
  margin: 40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
}

.good-item {
  width: 100%;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 20rpx;
  overflow: hidden;
  gap: 20rpx;
}

.good-card {
  width: 100%;
  margin-top: 0%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.good-type {
  position: absolute;
  top: 16rpx;
  left: 20rpx;
  font-size: 24rpx;
  background-color: rgb(255, 12, 12);
  color: #FFFFFF;
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
  z-index: 10;
  box-shadow: 0 2rpx 4rpx;
  white-space: nowrap;
}

.good-img {
  width: 100%;
  margin-top: 0%;
  display: flex;
  object-fit: cover;
  overflow: hidden;
  position: relative;
}

.good-title {
  padding: 14rpx 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 分类商品价格区域 - 修复 */
.good-price {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  padding: 0 20rpx 20rpx !important;
  font-weight: bold;
}

.good-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.good-pricetext {
  font-size: 32rpx;
  color: #FF6B6B;
  margin-left: 8rpx;
}

/* 购物车图标 - 移除绝对定位 */
.good-price .icon-cart {
  font-size: 44rpx;
  color: #e0e7ff;
  margin-left: 20rpx;
  position: static !important;
  right: auto !important;
  bottom: auto !important;
  transform: none !important;
}

.category-nav {
  background: #0F172A;
  padding: 10rpx 0;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-items {
  display: inline-flex;
  padding: 10rpx 20rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
  padding: 15rpx 10rpx;
  color: #94A3B8;
}

.category-item.active {
  color: #FFFFFF;
  border-bottom: 4rpx solid #3B82F6;
}

.category-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.category-icon image {
  width: 100%;
  height: 100%;
}

.menu-backc .category-image {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
}

.good-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  gap: 20rpx;
}

.good-item {
  width: calc(50% - 15rpx);
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
  padding: 20rpx;
}

.good-img-container {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 15rpx;
  overflow: hidden;
}

.good-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.back-button {
  display: flex;
  align-items: center;
  margin: 10rpx;
  font-size: 28rpx;
}

.back-button .iconfont {
  font-size: 26rpx;
}

/* 删除这些有问题的样式，它们会导致布局混乱 */
/*
.hot-price .iconfont,
.good-price .iconfont {
  font-size: 40rpx;
  position: absolute;
  right: 20rpx;
  bottom: 15rpx;
  cursor: pointer;
  transition: all 0.1s ease;
}
*/

.iconfont:active {
  transform: scale(0.95);
  opacity: 0.7;
}

/* 删除这些已废弃的样式 */
.hot-pricebefore,
.good-pricebefore {
  display: none;
}

.cart-popup {
  transform: translateZ(0);
  will-change: opacity, transform;
  backface-visibility: hidden;
  perspective: 1000px;
}

.cart-float-window {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #0d1b2a;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  z-index: 10000;
}

.cart-float-window .iconfont {
  font-size: 60rpx;
  color: #f5f5f5;
}

.cart-float-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #FF6B35;
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-status {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  margin: 20rpx 0;
}

.loading-text,
.no-more-text {
  font-size: 28rpx;
  color: #94A3B8;
  text-align: center;
}

.no-more-text {
  color: #64748B;
}

.buy-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
}

.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
}

.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.popup-body {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.popup-img {
  width: 180rpx;
  height: 180rpx;
  object-fit: cover;
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.popup-info {
  flex: 1;
}

.popup-title-text {
  font-size: 28rpx;
  color: #e0e1dd;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.popup-price {
  font-size: 32rpx;
  color: #4facfe;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.popup-spec {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #6c7586;
  margin-bottom: 8rpx;
}

.popup-stock {
  font-size: 24rpx;
  color: #6c7586;
}

.popup-spec-section {
  margin-bottom: 32rpx;
}

.popup-spec-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.popup-spec-group-name {
  font-size: 26rpx;
  color: #a0a5b1;
  margin-bottom: 16rpx;
}

.popup-spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.popup-spec-option {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border: 1px solid #364152;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #e0e1dd;
  background-color: rgba(255, 255, 255, 0.05);
  position: relative;
}

.popup-spec-option-selected {
  border-color: #4facfe;
  color: #4facfe;
  background-color: rgba(79, 172, 254, 0.1);
}

.popup-spec-option-selected::after {
  content: "✓";
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  color: #4facfe;
  font-size: 20rpx;
}

.popup-spec-option-disabled {
  color: #6c7586;
  background-color: rgba(255, 255, 255, 0.02);
  border-color: #2d3748;
  text-decoration: line-through;
  opacity: 0.5;
}

.buy-popup .popup-footer {
  display: flex;
  gap: 24rpx;
  margin: 0;
  padding: 0;
}

.buy-popup .popup-footer .cancel-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  line-height: 96rpx;
  text-align: center;
  background-color: rgba(255, 255, 255, 0.08);
  color: #e0e1dd;
  border: none;
  outline: none;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: none;
  transition: all 0.3s ease;
}

.buy-popup .popup-footer .cancel-btn:active {
  background-color: rgba(255, 255, 255, 0.15);
  transform: scale(0.98);
  opacity: 0.9;
}

.buy-popup .popup-footer .confirm-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  line-height: 96rpx;
  text-align: center;
  color: #fff;
  font-weight: bold;
  border: none;
  outline: none;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: none;
  transition: all 0.3s ease;
  position: relative;
}

.buy-popup .popup-footer .confirm-addCart {
  background: linear-gradient(90deg, #1677ff, #0052d9);
}

.buy-popup .popup-footer .confirm-addCart:not(.disabled):active {
  background: linear-gradient(90deg, #0052d9, #003eb3);
  transform: scale(0.98);
}

.buy-popup .popup-footer .confirm-buyNow {
  background: linear-gradient(90deg, #4facfe, #00f2fe);
}

.buy-popup .popup-footer .confirm-buyNow:not(.disabled):active {
  background: linear-gradient(90deg, #00f2fe, #00d9e6);
  transform: scale(0.98);
}

.buy-popup .popup-footer .confirm-btn.disabled {
  background: #6c7586 !important;
  color: #a0a5b1;
  cursor: not-allowed;
  transform: none !important;
}

.buy-popup .popup-footer .confirm-btn.disabled:active {
  background: #6c7586 !important;
  transform: none !important;
  opacity: 1 !important;
}

.buy-popup .popup-footer .cancel-btn,
.buy-popup .popup-footer .confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

.buy-popup .popup-footer button {
  margin: 0;
  padding: 0;
  line-height: normal;
  border: none;
  background: none;
}

.buy-popup .popup-footer button::after {
  border: none;
}

.popup-spec-option-img {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.popup-spec-option-text {
  flex: 1;
}

.color-block {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.popup-spec-option-selected .color-block {
  border-color: #4facfe;
}

.price-adjustment {
  font-size: 22rpx;
  color: #ff6b6b;
  margin-left: 8rpx;
  font-weight: bold;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #0F172A;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.search-back {
  display: flex;
  align-items: center;
  color: #4facfe;
  font-size: 28rpx;
  margin-right: 30rpx;
}

.search-back .iconfont {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.search-info {
  flex: 1;
}

.search-keyword {
  color: #4facfe;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.search-count {
  color: #94A3B8;
  font-size: 26rpx;
}

.search-results {
  padding: 20rpx;
}

.cart-float-window {
  z-index: 9998;
}


/* 固定搜索框容器 */
.fixed-search-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: #0F172A;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

/* 搜索状态下的固定头部 */
.fixed-search-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: #0F172A;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

/* 页面内容容器 - 添加顶部内边距 */
.page-content {
  margin-top: 110rpx; /* 搜索框高度 + 适当间距 */
  min-height: calc(100vh - 110rpx);
}

/* 搜索模式下的页面内容 */
.page-content.search-mode {
  margin-top: 100rpx; /* 搜索头部高度 */
  min-height: calc(100vh - 100rpx);
}

/* 调整原有的搜索头部样式 */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #0F172A;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}