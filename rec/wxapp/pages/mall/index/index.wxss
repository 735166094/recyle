.search-good-list {
  padding: 20rpx;
}

.search-good-item {
  display: flex;
  background: linear-gradient(135deg, #1b263b, #1a2538);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.search-good-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 30rpx;
}

.search-good-info {
  flex: 1;
}

.search-good-title {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 40rpx;
  margin-bottom: 16rpx;
