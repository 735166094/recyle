/* 页面基础样式 */
.pointcenter-container {
  min-height: 100vh;
  background: #000000;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #000000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  border-top-color: #ffffff;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

/* 内容区域 */
.content-wrapper {
  padding: 0 40rpx 40rpx;
  animation: fadeInUp 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头部区域 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.header-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title-text {
  font-size: 56rpx;
  font-weight: 300;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.subtitle-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
  letter-spacing: 4rpx;
}

.header-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.action-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.action-icon {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
}

/* 积分概览 */
.points-overview {
  margin-bottom: 40rpx;
}

.overview-header {
  margin-bottom: 32rpx;
}

.overview-title {
  font-size: 36rpx;
  font-weight: 300;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.overview-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
  letter-spacing: 4rpx;
}

.points-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.point-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.point-card:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
}

.trend-indicator {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.trend-indicator.up {
  color: #4ade80;
}

.trend-indicator.down {
  color: #f87171;
}

.trend-text {
  font-size: 20rpx;
  font-weight: 300;
}

.card-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.value-number {
  font-size: 48rpx;
  font-weight: 200;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.value-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

/* 区域标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 300;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.section-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
  letter-spacing: 4rpx;
}

.view-all-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.view-all-btn:active {
  background: rgba(255, 255, 255, 0.1);
}

.view-all-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
}

.view-all-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
}

/* 任务区域 */
.tasks-section {
  margin-bottom: 40rpx;
}

.tasks-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.task-item:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.task-item.completed {
  opacity: 0.6;
  background: rgba(34, 197, 94, 0.05);
  border-color: rgba(34, 197, 94, 0.2);
}

.task-icon-wrapper {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

/* 通用图标基础样式 */
.icon-base {
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-color: transparent !important;
}

/* 任务图标 - 使用较大的尺寸 */
.task-icon {
  width: 40rpx;
  height: 40rpx;
}

