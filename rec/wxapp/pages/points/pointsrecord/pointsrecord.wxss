/* 页面基础样式 */
.record-container {
  min-height: 100vh;
  background: #000000;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #000000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  border-top-color: #ffffff;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

/* 内容区域 */
.content-wrapper {
  padding: 0 40rpx 40rpx;
  animation: fadeInUp 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头部区域 */
.header-section {
  padding: 60rpx 0 40rpx;
}

.header-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title-text {
  font-size: 56rpx;
  font-weight: 300;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.subtitle-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
  letter-spacing: 4rpx;
}

/* 统计卡片 */
.stats-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

.stats-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, #ffffff, transparent);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 200;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.stat-value.positive {
  color: #22c55e;
}

.stat-value.negative {
  color: #f87171;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

/* 筛选区域 */
.filter-section {
  margin-bottom: 40rpx;
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
}

.filter-tab {
  flex: 1;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}

.filter-tab:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.98);
}

.tab-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
}

.filter-tab.active .tab-text {
  color: #ffffff;
  font-weight: 400;
}

/* 记录列表 */
.records-section {
  margin-bottom: 40rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.record-item:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.record-icon {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 400;
}

.record-icon.checkin::before {
  content: "\ec53";
  font-family: "iconfont";
}

.record-icon.exchange::before {
  content: "\ec41";
  font-family: "iconfont";
}

.record-icon.recycle::before {
  content: "\ec6b";
  font-family: "iconfont";
}

.record-icon.activity::before {
  content: "\ec32";
  font-family: "iconfont";
}

.record-icon.punch::before {
  content: "\ec49";
  font-family: "iconfont";
}

.record-icon.invite::before {
  content: "\ec40";
  font-family: "iconfont";
}

.record-icon.login::before {
  content: "\ec35";
  font-family: "iconfont";
}

.record-icon.profile::before {
  content: "\ec64";
  font-family: "iconfont";
}

.record-icon.share::before {
  content: "\ec40";
  font-family: "iconfont";
}

.record-icon.comment::before {
  content: "\ec4b";
  font-family: "iconfont";
}

.record-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-title {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 400;
}

.record-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
}

.record-amount {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.amount-text {
  font-size: 32rpx;
  font-weight: 400;
}

.amount-text.earn {
  color: #22c55e;
}

.amount-text.spend {
  color: #f87171;
}

.amount-status {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 80rpx 40rpx;
  color: rgba(255, 255, 255, 0.4);
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 300;
}

/* 加载更多 */
.loading-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx;
  color: rgba(255, 255, 255, 0.6);
}

.loading-more .loading-spinner {
  width: 32rpx;
  height: 32rpx;
}

.loading-more .loading-text {
  font-size: 24rpx;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx;
  color: rgba(255, 255, 255, 0.4);
}

.no-more-text {
  font-size: 24rpx;
  font-weight: 300;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 80rpx 40rpx;
  color: rgba(255, 255, 255, 0.6);
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 50%;
  border: 2rpx solid rgba(239, 68, 68, 0.2);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ef4444;
}

.error-text {
  font-size: 28rpx;
  font-weight: 300;
}

.retry-btn {
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.retry-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.retry-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
}

