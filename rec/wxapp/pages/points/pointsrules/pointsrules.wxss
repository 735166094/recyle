/* 页面基础样式 */
.rules-container {
  min-height: 100vh;
  background: #000000;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #000000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  border-top-color: #ffffff;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

/* 内容区域 */
.content-wrapper {
  padding: 0 40rpx 40rpx;
  animation: fadeInUp 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头部区域 */
.header-section {
  padding: 60rpx 0 40rpx;
}

.header-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title-text {
  font-size: 56rpx;
  font-weight: 300;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.subtitle-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
  letter-spacing: 4rpx;
}

/* 规则内容 */
.rules-content {
  margin-bottom: 40rpx;
}

.rule-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.section-header:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.section-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-title .title-text {
  font-size: 32rpx;
  font-weight: 400;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.section-title .title-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
}

.section-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
  transition: transform 0.3s ease;
}

.section-arrow.expanded {
  transform: rotate(90deg);
}

.section-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.section-content.expanded {
  max-height: 2000rpx;
  margin-top: 24rpx;
}

/* 规则网格 */
.rules-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.rule-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  transition: all 0.3s ease;
}

.rule-card.completed {
  background: rgba(34, 197, 94, 0.1);
  border-color: rgba(34, 197, 94, 0.2);
}

.rule-card:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.rule-icon {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  background-size: 32rpx;
  background-repeat: no-repeat;
  background-position: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  margin-bottom: 20rpx;
}

