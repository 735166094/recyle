.rule-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rule-title {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 400;
}

.rule-points {
  font-size: 24rpx;
  color: #22c55e;
  font-weight: 400;
}

.rule-frequency {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

.rule-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
  line-height: 1.4;
}

.rule-condition {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
}

.status-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 12rpx;
  background: #22c55e;
  border-radius: 12rpx;
  font-size: 18rpx;
  color: white;
  font-weight: 400;
}

.important-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 12rpx;
  background: #f87171;
  border-radius: 12rpx;
  font-size: 18rpx;
  color: white;
  font-weight: 400;
}

/* 规则列表 */
.rules-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  transition: all 0.3s ease;
}

.rule-item.important {
  background: rgba(248, 113, 113, 0.1);
  border-color: rgba(248, 113, 113, 0.2);
}

.rule-item:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

/* 底部操作 */
.bottom-actions {
  margin-top: 40rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.primary:active {
  background: rgba(255, 255, 255, 0.9);
}

.action-btn.secondary:active {
  background: rgba(255, 255, 255, 0.2);
}

.btn-text {
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.action-btn.primary .btn-text {
  color: #000000;
}

.action-btn.secondary .btn-text {
  color: #ffffff;
}

.contact-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.contact-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

.contact-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.contact-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.contact-icon {
  font-size: 24rpx;
}

.contact-btn .contact-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
}