/* 页面基础样式 */
.checkin-container {
  min-height: 100vh;
  background: #000000;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #000000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  border-top-color: #ffffff;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

/* 内容区域 */
.content-wrapper {
  padding: 0 40rpx 40rpx;
  animation: fadeInUp 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头部区域 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.header-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title-text {
  font-size: 56rpx;
  font-weight: 300;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.subtitle-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
  letter-spacing: 4rpx;
}

.header-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.action-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.action-icon {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
}

/* 统计卡片 */
.stats-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

.stats-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, #ffffff, transparent);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 200;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

/* 签到按钮 */
.checkin-section {
  margin-bottom: 40rpx;
}

.checkin-button {
  width: 100%;
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.checkin-button:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.98);
}

.checkin-button.checked {
  background: rgba(34, 197, 94, 0.1);
  border-color: rgba(34, 197, 94, 0.2);
}

.checkin-button.checking {
  background: rgba(59, 130, 246, 0.1);
  border-color: rgba(59, 130, 246, 0.2);
}

.button-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.button-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-circle {
  width: 60rpx;
  height: 60rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  position: relative;
}

.icon-circle::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 20rpx;
  background: #ffffff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.button-text {
  font-size: 36rpx;
  font-weight: 400;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.button-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

/* 区域标题 */
.section-header {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 300;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.section-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
  letter-spacing: 4rpx;
}

/* 签到规则 */
.rules-section {
  margin-bottom: 40rpx;
}

.rules-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.rule-item {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.rule-item.bonus {
  background: rgba(34, 197, 94, 0.1);
  border-color: rgba(34, 197, 94, 0.2);
}

.rule-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.day-number {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
}

.bonus-badge {
  font-size: 18rpx;
  color: #22c55e;
  font-weight: 400;
  padding: 4rpx 8rpx;
  background: rgba(34, 197, 94, 0.2);
  border-radius: 8rpx;
}

.rule-points {
  font-size: 28rpx;
  color: #22c55e;
  font-weight: 400;
}

/* 日历区域 */
.calendar-section {
  margin-bottom: 40rpx;
}

.calendar-wrapper {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.calendar-day.checked {
  background: rgba(34, 197, 94, 0.2);
  border: 1rpx solid rgba(34, 197, 94, 0.3);
}

.calendar-day.today {
  background: rgba(59, 130, 246, 0.2);
  border: 1rpx solid rgba(59, 130, 246, 0.3);
}

.day-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 400;
}

.check-mark {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  background: #22c55e;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 12rpx;
  font-weight: 600;
}

/* 积分弹窗 */
.points-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.popup-content {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  backdrop-filter: blur(20rpx);
  animation: scaleIn 0.3s ease;
}

@keyframes scaleIn {
  from { transform: scale(0.8); }
  to { transform: scale(1); }
}

.popup-icon {
  font-size: 80rpx;
  animation: bounce 0.6s ease;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-20rpx); }
  60% { transform: translateY(-10rpx); }
}

.popup-title {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 400;
}

.popup-points {
  font-size: 48rpx;
  color: #22c55e;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.popup-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

