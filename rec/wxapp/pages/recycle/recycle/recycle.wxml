    <!-- 底部 -->
    <view class="footer">
      <text class="footer-text">© 2023 奇奇回收 版权所有</text>
      <text class="footer-text">正规资质 · 专业服务 · 环保处理</text>
    </view>
  </scroll-view>

</view>